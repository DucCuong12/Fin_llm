<mxfile host="app.diagrams.net"><diagram id="VolTilt pipeline" name="VolTilt pipeline"><mxGraphModel dx="800" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="460" pageHeight="516" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;1. News articles&lt;/b&gt;&lt;br&gt;x &amp;isin; X&lt;sub&gt;i,t&lt;/sub&gt;&lt;br&gt;dated, no intraday time" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="195" height="54" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;2. LLM event extractor g&lt;/b&gt;&lt;br&gt;JSON schema, temperature 0&lt;br&gt;focus, type, novelty,&lt;br&gt;hard_numbers,&lt;br&gt;impact &amp;isin; {-2..+2}&lt;br&gt;cached per article" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="72" width="195" height="96" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;3. Hard-number gate&lt;/b&gt;&lt;br&gt;keep only focus = main subject&lt;br&gt;and hard_numbers = true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="186" width="195" height="54" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;4. Daily score and smoothing&lt;/b&gt;&lt;br&gt;h&lt;sub&gt;i,t&lt;/sub&gt; = sum of kept impacts&lt;br&gt;s&lt;sub&gt;i,t&lt;/sub&gt; = &amp;alpha; h&lt;sub&gt;i,t&lt;/sub&gt; + (1-&amp;alpha;) s&lt;sub&gt;i,t-1&lt;/sub&gt;&lt;br&gt;&amp;alpha; = 2/21 (span 20 days)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="258" width="195" height="68" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;5. Rank tilt &amp;tau;&lt;sub&gt;i,t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;1 + k (&amp;rho; - &amp;rho;&amp;#772;) / ((n-1)/2)&lt;br&gt;k = 0.5, mean tilt = 1&lt;br&gt;n &amp;lt; 3: tilt off (&amp;tau; = 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="344" width="195" height="68" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;A. Prices and returns&lt;/b&gt;&lt;br&gt;r&lt;sub&gt;i,t&lt;/sub&gt; = p&lt;sub&gt;i,t&lt;/sub&gt; / p&lt;sub&gt;i,t-1&lt;/sub&gt; - 1&lt;br&gt;live set A&lt;sub&gt;t&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="265" y="0" width="195" height="54" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;B. Tilted portfolio return&lt;/b&gt;&lt;br&gt;r&amp;#771;&lt;sub&gt;t&lt;/sub&gt; = mean&lt;sub&gt;i&lt;/sub&gt; (&amp;tau;&lt;sub&gt;i,t-1&lt;/sub&gt; &amp;middot; r&lt;sub&gt;i,t&lt;/sub&gt;)&lt;br&gt;uses yesterday's tilt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="265" y="72" width="195" height="54" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;C. Realised volatility&lt;/b&gt;&lt;br&gt;&amp;sigma;&amp;#770;&lt;sub&gt;t&lt;/sub&gt; = &amp;radic;P &amp;middot; std of the last&lt;br&gt;20 days of r&amp;#771;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="265" y="144" width="195" height="54" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;D. Volatility budget&lt;/b&gt;&lt;br&gt;&amp;lambda;&lt;sub&gt;t&lt;/sub&gt; = min(1, 20% / &amp;sigma;&amp;#770;&lt;sub&gt;t&lt;/sub&gt;)&lt;br&gt;&amp;lambda; = 1 until 20 days exist" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="265" y="216" width="195" height="54" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;E. Exposure and execution&lt;/b&gt;&lt;br&gt;w&lt;sub&gt;i,t&lt;/sub&gt; = &amp;lambda;&lt;sub&gt;t&lt;/sub&gt; &amp;middot; &amp;tau;&lt;sub&gt;i,t&lt;/sub&gt;, long-only, never levered&lt;br&gt;position at close t earns t&amp;rarr;t+1, cost 5 bps &amp;middot; |&amp;Delta;w|" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="448" width="300" height="68" as="geometry"/></mxCell><mxCell id="e19" value="tilt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="n6" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="budget" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="n14" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;dashed=1;" edge="1" parent="1" source="n6" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>