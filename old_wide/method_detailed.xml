<mxfile host="app.diagrams.net"><diagram id="voltilt" name="VolTilt detailed pipeline"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Text pipeline (the only place an LLM is used): one LLM call per article, none per decision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1180" height="210" as="geometry"/></mxCell><mxCell id="n3" value="Price pipeline (no LLM)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="250" width="1180" height="220" as="geometry"/></mxCell><mxCell id="n4" value="Frozen design protocol (chosen on data disjoint from the test windows, before any benchmark run)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="500" width="1180" height="130" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;1. News articles&lt;/b&gt;&lt;br&gt;x &amp;isin; X&lt;sub&gt;i,t&lt;/sub&gt;&lt;br&gt;dated, no intraday time" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="170" height="120" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;2. LLM event extractor g&lt;/b&gt;&lt;br&gt;JSON schema, temperature 0&lt;br&gt;focus, type, novelty,&lt;br&gt;hard_numbers, impact &amp;isin; {-2..+2}&lt;br&gt;cached per article" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="225" y="60" width="170" height="120" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;3. Hard-number gate&lt;/b&gt;&lt;br&gt;keep only&lt;br&gt;focus = main subject&lt;br&gt;AND hard_numbers = true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="170" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;4. Daily score&lt;/b&gt;&lt;br&gt;h&lt;sub&gt;i,t&lt;/sub&gt; = sum of impacts&lt;br&gt;of kept records&lt;br&gt;(0 if no news)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="60" width="170" height="120" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;5. Smoothing (EMA)&lt;/b&gt;&lt;br&gt;s&lt;sub&gt;i,t&lt;/sub&gt; = &amp;alpha; h&lt;sub&gt;i,t&lt;/sub&gt; + (1-&amp;alpha;) s&lt;sub&gt;i,t-1&lt;/sub&gt;&lt;br&gt;&amp;alpha; = 2/21 (span 20 days)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="60" width="170" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;6. Rank tilt &amp;tau;&lt;sub&gt;i,t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;1 + k (&amp;rho; - &amp;rho;&amp;#772;) / ((n-1)/2)&lt;br&gt;k = 0.5, mean tilt = 1&lt;br&gt;n &amp;lt; 3: tilt off (&amp;tau; = 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1005" y="60" width="170" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;A. Adjusted prices&lt;/b&gt;&lt;br&gt;p&lt;sub&gt;i,t&lt;/sub&gt;, live set A&lt;sub&gt;t&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="170" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;B. Asset returns&lt;/b&gt;&lt;br&gt;r&lt;sub&gt;i,t&lt;/sub&gt; = p&lt;sub&gt;i,t&lt;/sub&gt; / p&lt;sub&gt;i,t-1&lt;/sub&gt; - 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="225" y="300" width="170" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;C. Tilted portfolio return&lt;/b&gt;&lt;br&gt;r&amp;#771;&lt;sub&gt;t&lt;/sub&gt; = mean&lt;sub&gt;i&lt;/sub&gt; (&amp;tau;&lt;sub&gt;i,t-1&lt;/sub&gt; &amp;middot; r&lt;sub&gt;i,t&lt;/sub&gt;)&lt;br&gt;uses yesterday's tilt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="170" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;D. Realised volatility&lt;/b&gt;&lt;br&gt;&amp;sigma;&amp;#770;&lt;sub&gt;t&lt;/sub&gt; = &amp;radic;P &amp;middot; std of last 20 days of r&amp;#771;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="300" width="170" height="120" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;E. Volatility budget&lt;/b&gt;&lt;br&gt;&amp;lambda;&lt;sub&gt;t&lt;/sub&gt; = min(1, 20% / &amp;sigma;&amp;#770;&lt;sub&gt;t&lt;/sub&gt;)&lt;br&gt;&amp;lambda; = 1 until 20 days exist" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="300" width="170" height="120" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;F. Exposure&lt;/b&gt;&lt;br&gt;w&lt;sub&gt;i,t&lt;/sub&gt; = &amp;lambda;&lt;sub&gt;t&lt;/sub&gt; &amp;middot; &amp;tau;&lt;sub&gt;i,t&lt;/sub&gt;&lt;br&gt;long-only, never levered" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="210" width="230" height="90" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;G. Execution&lt;/b&gt;&lt;br&gt;position set at close t earns t&amp;rarr;t+1&lt;br&gt;cost 5 bps &amp;middot; |&amp;Delta;w|&lt;br&gt;portfolio = mean over live assets" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="340" width="230" height="100" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;H. Metrics&lt;/b&gt;&lt;br&gt;CR, Sharpe, max drawdown&lt;br&gt;over the held-out window" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="480" width="230" height="90" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Relative floor on target&lt;/b&gt; &amp;sigma;* = max(20%, q &amp;middot; 252-day vol), q &amp;isin; {0, 0.5, 0.75}&lt;br&gt;price-only, 6 stocks, 2001-2019, two halves. Adopt q &amp;gt; 0 only if Sharpe beats q = 0 in both halves. Result: q = 0." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="540" height="70" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Tilt form&lt;/b&gt; &amp;isin; {off, rank, magnitude}, separately for N = 2 and N &amp;ge; 3&lt;br&gt;all 2-4 asset subsets of 4 stocks, 2019-12-30 to 2022-10-05, two halves. Adopt a form only if it beats 'off' in both halves. Result: N &amp;ge; 3 rank, N = 2 off." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="545" width="560" height="70" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="n12" 